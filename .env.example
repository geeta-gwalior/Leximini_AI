# =====================================================================
# LexiMini AI — Environment Configuration
# Copy this file to `.env` before running services locally or in Docker.
# =====================================================================

# ---------------------------------------------------------------------
# API Gateway Settings
# ---------------------------------------------------------------------
PROJECT_NAME="LexiMini AI"
API_V1_STR="/api/v1"
SECRET_KEY="leximini-dev-secret-change-this-in-production-environments!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL (SQLite default for local zero-config dev; PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./leximini_dev.db"

# CORS origins (React Vite frontend default: http://localhost:3000)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# ---------------------------------------------------------------------
# Microservice Inter-Service URLs
# ---------------------------------------------------------------------
GATEWAY_URL="http://localhost:8000"
RAG_SERVICE_URL="http://localhost:8001"
MODEL_SERVER_URL="http://localhost:8002"

# ---------------------------------------------------------------------
# Vector Database (Qdrant)
# Defaults to in-memory mode if QDRANT_HOST is empty or unreachable.
# ---------------------------------------------------------------------
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="indian_laws"

# ---------------------------------------------------------------------
# Model Server Backend (Ollama / vLLM / Mock Mode)
# Leave API keys empty to default to local lightweight fallback mode.
# ---------------------------------------------------------------------
MODEL_BACKEND="mock"  # Options: "mock", "ollama", "vertex"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="leximini-7b"
